# Server
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# CORS (comma-separated origins, or * for all)
CORS_ORIGIN=http://localhost:3000

# Logging
LOG_LEVEL=info

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Database (Postgres) — matches docker-compose.yml. Leave DATABASE_URL unset to
# run without DB features (crawl-persistence and search will be disabled).
DATABASE_URL=postgres://search:search@localhost:5432/ai_search
DATABASE_POOL_MAX=10
DATABASE_SSL=false
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECTION_TIMEOUT_MS=10000

# Redis (OPTIONAL) — enables the async crawl queue, response caching, and
# distributed rate limiting. Leave REDIS_URL unset to run without it: crawls run
# synchronously, caching is skipped, and rate limiting is in-memory.
# REDIS_URL=redis://localhost:6379
QUEUE_ENABLED=true
QUEUE_CONCURRENCY=2
QUEUE_ATTEMPTS=3
# Run the crawl worker inside the API process. Set false + run `npm run worker`
# separately to scale workers independently of the API.
QUEUE_RUN_IN_PROCESS=true
CACHE_SEARCH_TTL=60
CACHE_ANSWER_TTL=300
CACHE_EMBEDDING_TTL=86400

# Search
# Postgres text-search config: drives tokenization, stopwords, and stemming.
SEARCH_LANGUAGE=english
# Minimum trigram similarity (0–1) for typo-tolerant "fuzzy" results.
SEARCH_FUZZY_THRESHOLD=0.2
# Default mode when the client doesn't specify: auto|fulltext|fuzzy|semantic|hybrid
SEARCH_DEFAULT_MODE=auto
# Reciprocal-rank-fusion constant + candidate pool size for hybrid search.
SEARCH_RRF_K=60
SEARCH_CANDIDATE_POOL=50

# Embeddings (semantic search). provider: openai | local | hash | none
#   openai → text-embedding-3-small (dim 1536); needs OPENAI_API_KEY
#   local  → Xenova/all-MiniLM-L6-v2 (dim 384); needs `npm i @xenova/transformers`
#   hash   → offline, dependency-free (dim 256); low quality — dev/CI default
#   none   → semantic search disabled (lexical only)
# EMBEDDING_DIM MUST match the provider AND the migrated pages.embedding column.
EMBEDDING_PROVIDER=hash
EMBEDDING_MODEL=hash-256
EMBEDDING_DIM=256
EMBEDDING_BATCH_SIZE=64

# AI answer box. provider: openai | none. Without a key, answers fall back to a
# non-LLM extractive summary, so the endpoint always works.
LLM_PROVIDER=none
# OPENAI_API_KEY=sk-...
LLM_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
ANSWER_MAX_SOURCES=6
ANSWER_MAX_CONTEXT_CHARS=1200
ANSWER_TEMPERATURE=0.2

# --- To enable OpenAI (semantic + LLM answers), set instead: ---
# EMBEDDING_PROVIDER=openai
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIM=1536      # then run `npm run db:reset` (or a new migration) so the column matches
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...
