{
  "name": "ai-search-engine-backend",
  "version": "1.0.0",
  "description": "Node/Express backend for the AI Search Engine",
  "type": "module",
  "main": "dist/server.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "worker": "tsx watch src/worker.ts",
    "worker:prod": "node dist/worker.js",
    "crawl": "tsx src/scripts/crawl.ts",
    "embed": "tsx src/scripts/embed.ts",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:migrate:prod": "node dist/db/migrate.js",
    "db:reset": "tsx src/db/migrate.ts --reset",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/**/*.test.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "keywords": [
    "express",
    "node",
    "ai",
    "search",
    "api"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "bullmq": "^6.3.6",
    "cheerio": "^1.2.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "fast-xml-parser": "^5.11.0",
    "helmet": "^7.1.0",
    "ioredis": "^6.0.0",
    "morgan": "^1.10.0",
    "p-limit": "^7.3.1",
    "pg": "^8.23.0",
    "rate-limit-redis": "^4.3.1",
    "robots-parser": "^3.0.1",
    "winston": "^3.13.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^8.57.0",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/morgan": "^1.9.10",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.23.1",
    "eslint": "^8.57.0",
    "prettier": "^3.3.3",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0"
  }
}
